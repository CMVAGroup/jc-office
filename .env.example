# AI Office — serverconfiguratie. Secrets blijven leeg; lokale modelkeuze ingevuld.
# Kopieer op de VPS naar .env en voer chmod 600 .env uit. Nooit committen.
# Leeg betekent: Compose-standaard, tenzij hieronder verplicht staat.
# docker compose config uitsluitend met --quiet: anders kunnen secrets verschijnen.

# PostgreSQL: wachtwoord VERPLICHT, lang en willekeurig.
# Gebruiker/database: eenvoudige SQL-identifiers; standaard office / jc_office.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Docker: niet invullen. Entrypoint maakt DATABASE_URL veilig uit PG-velden,
# uitsluitend naar postgres:5432. Lokaal scripts/db.mjs: eigen lokale URL invullen.
DATABASE_URL=

# Web: SESSION_SECRET VERPLICHT, willekeurig en minimaal 32 tekens.
SESSION_SECRET=
# Compose fixeert APP_URL op https://office.cmva.nl en webpoort op 3000.
APP_URL=
NODE_ENV=
DEMO_MODE=
EXTERNAL_WRITES_ENABLED=
# Laatste drie worden in Docker geforceerd: production / false / false.

# Model: Ollama lokaal op CPU; geen Anthropic-key of ALLOW_REAL_MODEL_RUNS nodig.
# Zonder ingevulde provider blijft de applicatiefallback mock. Dagbudget 5 USD.
# Activering: MODEL_PROVIDER=anthropic + ALLOW_REAL_MODEL_RUNS=true + eigen key.
MODEL_PROVIDER=claude-proxy
CLAUDE_PROXY_ENABLED=false
# Phase 9 levert alleen de HTTP-wrapper; worker-adapter volgt afzonderlijk.
# Proxy intern: http://claude-proxy:11435; lokaal: http://localhost:11435.
OLLAMA_MODEL=hermes3
# Alleen voor gebruik buiten Docker; standaard http://localhost:11434.
# Compose fixeert dit op http://ollama:11434.
OLLAMA_BASE_URL=
ALLOW_REAL_MODEL_RUNS=
ANTHROPIC_API_KEY=
# Leeg volgt de applicatiealias; controleer die vóór echte modelruns.
MODEL_ALIAS=
MODEL_MAX_CONCURRENT_RUNS=
MODEL_DAILY_BUDGET_USD=
# Gereserveerde lokale instelling; huidige worker leest dit veld nog niet.
MODEL_MAX_TOKENS_PER_RUN=

# CMVA: alleen-lezen. Standaardbasis https://cmva.nl.
# Token en exact winkelprofiel zelf invullen; zonder token geen echte sync.
CMVA_API_BASE=
CMVA_AI_SUMMARY_TOKEN=
CMVA_STORE_PROFILE=

# Worker: standaard 15 s watchdog, 20 s scheduler, 45 s vergaderanimatie.
WATCHDOG_INTERVAL_SECONDS=
SCHEDULER_TICK_SECONDS=
MEETING_VISUAL_SECONDS=
# Dagelijkse back-up: UTC-uur 0..23, standaard 3; bewaartermijn vast 14 dagen.
BACKUP_UTC_HOUR=

# Alleen lokale demo/ontwikkeling; niet doorgegeven door productie-Compose.
# Lokale poorten: 3210 web, 54329 DB, 54339 aparte testcluster.
WEB_PORT=
PG_PORT=
TEST_DATABASE_URL=
# Rapportagezone/valuta staan in de workspace; geen productie-override.
REPORTING_TIMEZONE=
SHOP_CURRENCY=

# Deployimage: leeg = latest; GitHub Actions zet tijdens deploy de exacte commit-SHA.
OFFICE_IMAGE_TAG=
